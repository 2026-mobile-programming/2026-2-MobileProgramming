<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JjanChall">

        <!-- 앱 시작 화면: 로그인 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- 영수증 등록 화면 -->
        <activity
            android:name=".ui.receipt.ReceiptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 지출 추가·수정 화면 -->
        <activity
            android:name=".ui.setting.BudgetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.record.ExpenseEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 통계 화면 -->
        <activity
            android:name=".ui.statistics.StatisticsActivity"
            android:exported="false" />

        <!-- 챌린지 만들기 화면 -->
        <activity
            android:name=".ui.challenge.CreateChallengeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.challenge.ChallengeDetailActivity"
            android:exported="false" />

    </application>

</manifest>