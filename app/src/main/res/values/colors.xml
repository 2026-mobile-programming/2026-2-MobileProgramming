<?xml version="1.0" encoding="utf-8"?>
<!--
    짠챌 디자인 시스템 색상
    1) Primitives: 실제 색값. 화면에서는 직접 쓰지 않아요.
    2) Semantic: 용도별 이름. 피그마 Color 변수와 같은 이름이에요.
       (피그마 bg/brand → @color/bg_brand, text/secondary → @color/text_secondary)
    레이아웃에서는 Semantic 이름만 써 주세요. 색을 바꿀 때 여기 한 곳만 고치면 돼요.
-->
<resources>

    <!-- ===== Primitives ===== -->
    <color name="green_50">#FFE6F4EF</color>
    <color name="green_100">#FFC2E6D9</color>
    <color name="green_500">#FF12A178</color>
    <color name="green_700">#FF0B7A5B</color>
    <color name="green_900">#FF064D39</color>

    <color name="gray_0">#FFFFFFFF</color>
    <color name="gray_50">#FFFAFAFA</color>
    <color name="gray_100">#FFF4F4F4</color>
    <color name="gray_200">#FFE6E6E6</color>
    <color name="gray_300">#FFCFCFCF</color>
    <color name="gray_400">#FFBDBDBD</color>
    <color name="gray_500">#FF8A8A8A</color>
    <color name="gray_600">#FF5C5C5C</color>
    <color name="gray_900">#FF1F1F1F</color>

    <color name="red_50">#FFFDECEC</color>
    <color name="red_600">#FFD63B3B</color>

    <color name="gold_400">#FFF5C542</color>

    <!-- 템플릿 기본값 (다른 곳에서 쓸 수 있어 남겨 둬요) -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ===== Semantic: 배경 ===== -->
    <color name="bg_default">@color/gray_0</color>
    <color name="bg_subtle">@color/gray_50</color>
    <color name="bg_muted">@color/gray_100</color>
    <color name="bg_brand">@color/green_700</color>
    <color name="bg_brand_pressed">@color/green_900</color>
    <color name="bg_brand_subtle">@color/green_50</color>
    <color name="bg_danger">@color/red_600</color>
    <color name="bg_danger_subtle">@color/red_50</color>
    <color name="bg_disabled">@color/gray_200</color>
    <color name="bg_dim">#73000000</color>

    <!-- ===== Semantic: 글자 ===== -->
    <color name="text_primary">@color/gray_900</color>
    <color name="text_secondary">@color/gray_600</color>
    <color name="text_disabled">@color/gray_400</color>
    <color name="text_on_brand">@color/gray_0</color>
    <color name="text_brand">@color/green_700</color>
    <color name="text_danger">@color/red_600</color>

    <!-- ===== Semantic: 테두리 ===== -->
    <color name="border_default">@color/gray_200</color>
    <color name="border_input">@color/gray_300</color>
    <color name="border_strong">@color/gray_900</color>
    <color name="border_brand">@color/green_700</color>
    <color name="border_danger">@color/red_600</color>

    <!-- ===== 통계 차트 카테고리 ===== -->
    <color name="chart_food">@color/green_700</color>
    <color name="chart_cafe">#FF8D6E63</color>
    <color name="chart_transport">#FF3B7DD8</color>
    <color name="chart_shopping">#FFE0679A</color>
    <color name="chart_living">@color/gold_400</color>
    <color name="chart_etc">@color/gray_400</color>

    <!-- 앱 아이콘 배경 -->
    <color name="ic_launcher_background">@color/green_700</color>

</resources>
