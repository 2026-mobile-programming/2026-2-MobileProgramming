<?xml version="1.0" encoding="utf-8"?>
<!--
    짠챌 디자인 시스템 컴포넌트 스타일
    피그마 컴포넌트와 1:1로 맞춰 둔 스타일이에요.
      피그마 Button / Primary   → @style/Widget.JjanChall.Button.Primary (MaterialButton 기본값)
      피그마 Button / Secondary → @style/Widget.JjanChall.Button.Secondary
      피그마 Button / Text      → @style/Widget.JjanChall.Button.Text
      피그마 Input              → @style/Widget.JjanChall.TextInput (TextInputLayout 기본값)
      피그마 Dialog             → @style/ThemeOverlay.JjanChall.Dialog (MaterialAlertDialog 기본값)
-->
<resources>

    <!-- ===== Button ===== -->
    <style name="Widget.JjanChall.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/size_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/selector_button_primary_bg</item>
        <item name="android:textColor">@color/selector_button_primary_text</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Button</item>
    </style>

    <style name="Widget.JjanChall.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/size_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Button</item>
    </style>

    <style name="Widget.JjanChall.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/size_touch_min</item>
        <item name="android:textColor">@color/text_brand</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Label</item>
    </style>

    <!-- ===== Input ===== -->
    <!-- 라벨은 입력칸 위에 TextView(Widget.JjanChall.InputLabel)로 따로 두고, 칸 안에는 placeholder만 보여줘요. -->
    <style name="Widget.JjanChall.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/bg_default</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/border_danger</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="errorTextColor">@color/text_danger</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.JjanChall.Caption</item>
        <item name="errorTextAppearance">@style/TextAppearance.JjanChall.Caption</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <!-- 입력칸 안의 글자 (TextInputEditText에 style로 지정) -->
    <style name="Widget.JjanChall.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="android:minHeight">@dimen/size_touch_min</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
    </style>

    <!-- 입력칸 위 라벨 -->
    <style name="Widget.JjanChall.InputLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Label</item>
    </style>

    <!-- ===== CheckBox ===== -->
    <style name="Widget.JjanChall.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/bg_brand</item>
        <item name="android:minHeight">@dimen/size_touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Body2</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ===== AppBar ===== -->
    <style name="Widget.JjanChall.AppBarTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Title</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ===== TabBar (하단 탭) ===== -->
    <style name="Widget.JjanChall.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">@dimen/size_tab_bar</item>
        <item name="backgroundTint">@color/bg_tab_bar</item>
        <!-- 그림자 색 덧칠(elevation overlay)을 꺼서 bg_tab_bar 색이 그대로 보이게 -->
        <item name="elevation">0dp</item>
        <!-- 시스템 내비게이션 바 높이만큼 아래 여백을 넣고, 그 영역까지 같은 색으로 칠해요 -->
        <item name="paddingBottomSystemWindowInsets">true</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">@dimen/size_icon</item>
        <item name="itemIconTint">@color/selector_tab_item</item>
        <item name="itemTextColor">@color/selector_tab_item</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.JjanChall.Caption</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.JjanChall.Caption.Strong</item>
        <!-- 피그마처럼 선택된 아이콘 뒤 배경(pill) 없이 색만 바뀌게 -->
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="itemRippleColor">@color/bg_muted</item>
    </style>

    <!-- 탭 화면 상단 제목 (뒤로가기 없는 AppBar) -->
    <style name="Widget.JjanChall.TabHeaderTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size_app_bar</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/screen_padding</item>
        <item name="android:paddingEnd">@dimen/screen_padding</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Title</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 구분선 -->
    <style name="Widget.JjanChall.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border_default</item>
    </style>

    <!-- ===== 설정 목록 한 줄 ===== -->
    <style name="Widget.JjanChall.ListRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/screen_padding</item>
        <item name="android:paddingEnd">@dimen/screen_padding</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.JjanChall.ListRowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Body</item>
    </style>

    <!-- 목록 위 작은 섹션 이름 (예: "가계부", "앱 설정") -->
    <style name="Widget.JjanChall.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/screen_padding</item>
        <item name="android:paddingTop">@dimen/spacing_xl</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Body2</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 작은 회색 태그 -->
    <style name="Widget.JjanChall.Tag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/spacing_sm</item>
        <item name="android:background">@drawable/bg_chip_muted</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 섹션 사이 굵은 구분 -->
    <style name="Widget.JjanChall.SectionGap" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/spacing_sm</item>
        <item name="android:background">@color/bg_muted</item>
    </style>

    <!-- ===== Dialog ===== -->
    <style name="ThemeOverlay.JjanChall.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.JjanChall.Dialog</item>
        <item name="colorSurface">@color/bg_default</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.JjanChall.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.JjanChall.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.JjanChall.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.JjanChall.Button.Dialog.Negative</item>
    </style>

    <style name="ShapeAppearance.JjanChall.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="MaterialAlertDialog.JjanChall.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Heading</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="MaterialAlertDialog.JjanChall.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.JjanChall.Body2</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.JjanChall.Button.Dialog.Negative" parent="Widget.JjanChall.Button.Text">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
