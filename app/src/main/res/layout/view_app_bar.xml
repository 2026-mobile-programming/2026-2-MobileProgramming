<?xml version="1.0" encoding="utf-8"?>
<!--
    공통 상단 바 (피그마 AppBar 컴포넌트)
    다른 화면에서 <include layout="@layout/view_app_bar" /> 로 재사용해요.
    제목은 코드에서 binding.appBar.tvAppBarTitle.text 로 바꿔요.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_app_bar"
    android:background="@color/bg_default"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingEnd="@dimen/spacing_lg">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/size_touch_min"
        android:layout_height="@dimen/size_touch_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/common_back"
        android:src="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/tv_app_bar_title"
        style="@style/Widget.JjanChall.AppBarTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_weight="1"
        tools:text="회원가입" />

</LinearLayout>
