<!-- CHALLENGE-01 무지출 챌린지 (한지수) -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:orientation="vertical"
    tools:context=".ui.challenge.ChallengeFragment">

    <!-- 공통 상단 헤더 -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <!-- 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- ScrollView의 유일한 직접 자식 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_md">

            <!-- 챌린지 만들기 / 초대 코드 참여 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_challenge"
                    style="@style/Widget.JjanChall.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/challenge_create" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_join_challenge"
                    style="@style/Widget.JjanChall.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/challenge_join_code"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/bg_default"
                    app:strokeColor="@color/border_strong"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- 진행 중인 챌린지 -->
            <TextView
                android:id="@+id/tv_ongoing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:text="@string/challenge_ongoing"
                android:textAppearance="@style/TextAppearance.JjanChall.Body2"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- 진행 중인 챌린지 목록 -->
            <LinearLayout
                android:id="@+id/layout_ongoing_challenges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_ongoing_challenges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_challenge" />

            </LinearLayout>

            <!-- 끝난 챌린지 -->
            <TextView
                android:id="@+id/tv_completed_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:text="@string/challenge_completed"
                android:textAppearance="@style/TextAppearance.JjanChall.Body2"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- 끝난 챌린지 목록 -->
            <LinearLayout
                android:id="@+id/layout_completed_challenges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">




                <!-- 끝난 챌린지 카드 -->
                <LinearLayout
                    android:id="@+id/card_completed_challenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_challenge_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- 챌린지 이름 -->
                    <TextView
                        android:id="@+id/tv_completed_challenge_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/challenge_preview_finished_title"
                        android:textAppearance="@style/TextAppearance.JjanChall.Body"
                        android:textColor="@color/text_secondary" />

                    <!-- 성공 배지 -->
                    <TextView
                        android:id="@+id/tv_challenge_success"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_chip_muted"
                        android:padding="@dimen/spacing_sm"
                        android:gravity="center"
                        android:text="@string/challenge_success"
                        android:textAppearance="@style/TextAppearance.JjanChall.Label"
                        android:textColor="@color/text_brand" />

                </LinearLayout>




            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
