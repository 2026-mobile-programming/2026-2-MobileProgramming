<?xml version="1.0" encoding="utf-8"?>
<!-- HOME-02 통계 화면 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:orientation="vertical">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size_touch_min"
            android:layout_height="@dimen/size_touch_min"
            android:contentDescription="뒤로 가기"
            android:gravity="center"
            android:text="‹"
            android:textAppearance="@style/TextAppearance.JjanChall.Heading"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="통계"
            android:textAppearance="@style/TextAppearance.JjanChall.Heading"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <View style="@style/Widget.JjanChall.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- Android TabHost -->
        <TabHost
            android:id="@android:id/tabhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xl">

                <!-- 월 선택 / 통계 탭 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 월 선택 Spinner -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="127dp"
                        android:background="@drawable/bg_statistics_spinner">

                        <Spinner
                            android:id="@+id/spinnerMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="@dimen/spacing_md"
                            android:paddingEnd="36dp"
                            android:spinnerMode="dropdown" />

                        <!-- 짠챌 공통 화살표 아이콘 -->
                        <ImageView
                            android:layout_width="@dimen/spacing_lg"
                            android:layout_height="@dimen/spacing_lg"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:src="@drawable/ic_chevron_down"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:clickable="false"
                            android:focusable="false" />

                    </FrameLayout>

                    <!-- 남는 공간을 사용하여 TabWidget을 오른쪽으로 정렬 -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- 93dp + 54dp = 147dp -->
                    <TabWidget
                        android:id="@android:id/tabs"
                        android:layout_width="147dp"
                        android:layout_height="@dimen/statistics_tab_height"
                        android:orientation="horizontal"
                        android:padding="0dp"
                        android:showDividers="none" />

                </LinearLayout>

                <!-- 통계 내용은 기존 좌우 20dp 여백 유지 -->
                <FrameLayout
                    android:id="@android:id/tabcontent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2xl"
                    android:layout_marginEnd="@dimen/spacing_md">

                    <!-- 카테고리별 통계 -->
                    <LinearLayout
                        android:id="@+id/tabCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Custom View Canvas 도넛 차트 -->
                        <FrameLayout
                            android:id="@+id/chartContainer"
                            android:layout_width="match_parent"
                            android:layout_height="220dp">

                            <com.app.jjanchall.ui.statistics.ExpenseDonutChartView
                                android:id="@+id/donutChart"
                                android:layout_width="220dp"
                                android:layout_height="220dp"
                                android:layout_gravity="center" />

                        </FrameLayout>

                        <!-- 카테고리별 금액 및 비율 목록 -->
                        <LinearLayout
                            android:id="@+id/layoutCategoryStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2xl"
                            android:orientation="vertical" />

                    </LinearLayout>


                    <!-- 월별 통계 -->
                    <LinearLayout
                        android:id="@+id/tabMonthly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 월별 지출 그래프 제목 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="월별 지출 비교"
                            android:textAppearance="@style/TextAppearance.JjanChall.Heading"
                            android:textColor="@color/text_primary" />

                        <!-- Canvas 막대그래프 -->
                        <com.app.jjanchall.ui.statistics.MonthlyBarChartView
                            android:id="@+id/monthlyBarChart"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:layout_marginTop="@dimen/spacing_xl" />

                        <!-- 6개월 합계 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2xl"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="6개월 총 지출"
                                android:textAppearance="@style/TextAppearance.JjanChall.Body2"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvMonthlyTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0원"
                                android:textAppearance="@style/TextAppearance.JjanChall.Heading"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </TabHost>

    </ScrollView>

</LinearLayout>
