<?xml version="1.0" encoding="utf-8"?>
<!-- HOME-02 통계 화면 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:orientation="vertical">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/screen_padding">

        <!-- 뒤로 가기 -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size_touch_min"
            android:layout_height="@dimen/size_touch_min"
            android:contentDescription="뒤로 가기"
            android:gravity="center"
            android:text="‹"
            android:textAppearance="@style/TextAppearance.JjanChall.Heading"
            android:textColor="@color/text_primary" />

        <!-- 통계 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="통계"
            android:textAppearance="@style/TextAppearance.JjanChall.Heading"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <!-- 헤더 아래 구분선 -->
    <View style="@style/Widget.JjanChall.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- 실제 Android TabHost 사용 -->
        <TabHost
            android:id="@android:id/tabhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_xl">

                <!-- 월 선택 / 카테고리별·월별 탭 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 월 선택 Spinner -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="127dp"
                        android:background="@drawable/bg_statistics_spinner">

                        <Spinner
                            android:id="@+id/spinnerMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="@dimen/spacing_md"
                            android:paddingEnd="36dp"
                            android:spinnerMode="dropdown" />

                        <!-- 기존 짠챌 공통 화살표 아이콘 -->
                        <ImageView
                            android:layout_width="@dimen/spacing_lg"
                            android:layout_height="@dimen/spacing_lg"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:src="@drawable/ic_chevron_down"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:clickable="false"
                            android:focusable="false" />

                    </FrameLayout>

                    <!-- Spinner와 TabHost 사이 간격 -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- 카테고리별 / 월별 탭 -->
                    <TabWidget
                        android:id="@android:id/tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/statistics_tab_height"
                        android:orientation="horizontal"
                        android:showDividers="none"
                        android:translationX="@dimen/spacing_sm" />

                </LinearLayout>

                <!-- 선택한 탭에 따라 내용 변경 -->
                <FrameLayout
                    android:id="@android:id/tabcontent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2xl">

                    <!-- 카테고리별 통계 -->
                    <LinearLayout
                        android:id="@+id/tabCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 다음 단계에서 Canvas 도넛 차트 추가 -->
                        <FrameLayout
                            android:id="@+id/chartContainer"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:foregroundGravity="center">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="원형 차트 구현 예정"
                                android:textAppearance="@style/TextAppearance.JjanChall.Body2"
                                android:textColor="@color/text_secondary" />

                        </FrameLayout>

                        <!-- 카테고리별 지출 목록 -->
                        <LinearLayout
                            android:id="@+id/layoutCategoryStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2xl"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <!-- 월별 통계 -->
                    <LinearLayout
                        android:id="@+id/tabMonthly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMonthlyPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="@dimen/spacing_2xl"
                            android:text="월별 통계 구현 예정"
                            android:textAppearance="@style/TextAppearance.JjanChall.Body2"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </TabHost>

    </ScrollView>

</LinearLayout>
