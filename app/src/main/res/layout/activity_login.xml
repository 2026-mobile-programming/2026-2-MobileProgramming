<?xml version="1.0" encoding="utf-8"?>
<!-- LOGIN-01 로그인 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:fillViewport="true"
    tools:context=".ui.login.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="72dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_2xl">

        <!-- 로고 + 앱 이름 + 소개 -->
        <ImageView
            android:layout_width="@dimen/size_logo"
            android:layout_height="@dimen/size_logo"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/common_logo"
            android:src="@drawable/img_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.JjanChall.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/login_tagline"
            android:textAppearance="@style/TextAppearance.JjanChall.Body2"
            android:textColor="@color/text_secondary" />

        <!-- 이메일 -->
        <TextView
            style="@style/Widget.JjanChall.InputLabel"
            android:layout_marginTop="40dp"
            android:labelFor="@id/et_email"
            android:text="@string/login_email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email"
                style="@style/Widget.JjanChall.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/login_email_hint"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 비밀번호 -->
        <TextView
            style="@style/Widget.JjanChall.InputLabel"
            android:layout_marginTop="@dimen/spacing_lg"
            android:labelFor="@id/et_password"
            android:text="@string/login_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                style="@style/Widget.JjanChall.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/login_password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_auto_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/login_auto_login" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/login_button" />

        <!-- 회원가입으로 이동 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                android:textAppearance="@style/TextAppearance.JjanChall.Body2"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_go_signup"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_touch_min"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:text="@string/login_go_signup"
                android:textAppearance="@style/TextAppearance.JjanChall.Body2"
                android:textColor="@color/text_brand"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
