<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    app:cardBackgroundColor="@color/bg_default"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm">

        <!-- 순위 번호 -->
        <TextView
            android:id="@+id/tv_rank_number"
            android:layout_width="20dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textSize="16sp"
            android:lineHeight="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- 프로필 원 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ranking_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/spacing_md"
            app:cardBackgroundColor="@color/border_default"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- 참여자 이름 -->
        <TextView
            android:id="@+id/tv_rank_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:textAppearance="@style/TextAppearance.JjanChall.Body"
            android:textSize="16sp"
            android:lineHeight="24sp"
            android:textStyle="normal"
            android:textColor="@color/text_primary" />

        <!-- 무지출 일수 -->
        <TextView
            android:id="@+id/tv_rank_days"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:textSize="16sp"
            android:lineHeight="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
