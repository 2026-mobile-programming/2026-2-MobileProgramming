<?xml version="1.0" encoding="utf-8"?>
<!--
    탭 화면 공통 상단 제목 (뒤로가기 없는 AppBar)
    Fragment 레이아웃에서 <include android:id="@+id/header" layout="@layout/view_tab_header" /> 로 쓰고
    제목은 코드에서 binding.header.tvHeaderTitle.setText(R.string.xxx) 로 바꿔요.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_default"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_header_title"
        style="@style/Widget.JjanChall.TabHeaderTitle"
        tools:text="@string/app_name" />

    <View style="@style/Widget.JjanChall.Divider" />

</LinearLayout>
