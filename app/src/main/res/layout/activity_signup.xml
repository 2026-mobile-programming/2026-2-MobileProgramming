<?xml version="1.0" encoding="utf-8"?>
<!-- LOGIN-02 회원가입 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:orientation="vertical"
    tools:context=".ui.login.SignupActivity">

    <!-- 공통 상단 바 재사용 -->
    <include
        android:id="@+id/app_bar"
        layout="@layout/view_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- 닉네임 -->
            <TextView
                style="@style/Widget.JjanChall.InputLabel"
                android:labelFor="@id/et_nickname"
                android:text="@string/signup_nickname" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/signup_nickname_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nickname"
                    style="@style/Widget.JjanChall.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/signup_nickname_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 이메일 -->
            <TextView
                style="@style/Widget.JjanChall.InputLabel"
                android:layout_marginTop="@dimen/spacing_lg"
                android:labelFor="@id/et_email"
                android:text="@string/login_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    style="@style/Widget.JjanChall.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="@string/login_email_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 -->
            <TextView
                style="@style/Widget.JjanChall.InputLabel"
                android:layout_marginTop="@dimen/spacing_lg"
                android:labelFor="@id/et_password"
                android:text="@string/login_password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:helperText="@string/signup_password_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    style="@style/Widget.JjanChall.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="@string/login_password_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 확인 -->
            <TextView
                style="@style/Widget.JjanChall.InputLabel"
                android:layout_marginTop="@dimen/spacing_lg"
                android:labelFor="@id/et_password_confirm"
                android:text="@string/signup_password_confirm" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password_confirm"
                    style="@style/Widget.JjanChall.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="@string/signup_password_confirm_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 고정 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_signup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:text="@string/signup_button" />

</LinearLayout>
